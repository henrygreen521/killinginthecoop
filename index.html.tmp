    .corner-sign {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 1000;
      max-width: 260px;
      background: #161616;
      border: 1px solid #c92a2a;
      border-radius: 8px;
      padding: 0.75rem 1rem;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.85);
      font-size: 0.85rem;
      line-height: 1.4;
    }

    .corner-sign a {
      color: #ffffff;
      font-weight: 700;
      text-decoration: none;
    }

    .corner-sign a:hover,
    .corner-sign a:focus {
      color: #ff5a5a;
      text-decoration: underline;
    }

